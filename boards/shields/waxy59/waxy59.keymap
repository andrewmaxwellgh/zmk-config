// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more instructions.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
        keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp ESC	  &kp N1	&kp N2	 &kp N3	&kp N4	&kp N5      &kp N6       &kp N7      &kp N8	    &kp N9     &kp N0      &none
		        &kp TAB   &kp Q     &kp W    &kp E   &kp R   &kp T      &kp Y        &kp U       &kp I      &kp O      &kp P       &kp BSPC
                &kp CAPS  &kp A     &kp S    &kp D   &kp F   &kp G      &kp H        &kp J       &kp K      &kp L      &kp SEMI    &kp APOS
                &kp LSHFT &kp Z     &kp X    &kp C   &kp V   &kp B      &kp N        &kp M       &kp COMMA  &kp DOT    &kp FSLH    &kp RSHFT
                &kp LCTRL &kp LALT  &kp LGUI &mo 1   &kp RET &kp SPACE  &none        &mo 2       &kp UP     &kp DOWN   &kp LEFT    &kp RIGHT
            				
            >;
        };

        lower_layer {
            display-name = "Lower Layer";
            //  ESC          1          2           3               4     5      6     7       8          9               0               -
            bindings = <
                &none        &none      &none       &none           &none &none &none &none    &none        &none           &none       &none 
                &none       &none        &none        &none        &none &none &none &none    &none        &none           &none       &kp DEL 
                &none       &none        &none        &none        &none &none &none &kp PLUS &kp MINUS    &kp EQUAL       &none       &none 
                &none       &none        &none        &none        &none &none &none &none    &none        &none           &none       &none 
                &none       &none        &none        &none        &none &none &none &none    &kp PG_UP    &kp PG_DN       &kp HOME    &kp END 
            >;
        };

        raise_layer {
            display-name = "Raise Layer";
            //  ESC             1             2          3            4         5           6     7       8          9               0               -
            bindings = <
                &bt BT_CLR  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &none        &none       &none &none    &none        &none           &none       &none 
                &none       &none        &none        &none        &sys_reset &none         &none &none    &none        &none           &kp C_PP    &none 
                &none       &none        &none        &none        &none        &none       &none &none    &none        &none           &none       &none 
                &none       &none        &none        &none        &none        &bootloader &none &none    &none        &none           &none       &none 
                &none       &none        &none        &none        &none        &none       &none &none    &kp C_VOL_UP &kp C_VOL_DN    &none       &none 
            >;
        };

    };
};

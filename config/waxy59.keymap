
#define ZMK_POINTING_DEFAULT_SCRL_VAL 10    // default: 10
#define ZMK_POINTING_DEFAULT_MOVE_VAL 5000  // default: 600

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

/ {

        macros {
        altf4: altf4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp F4>
                , <&macro_release &kp LALT>
				;
        };

        csx: csx {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_press &kp LSHFT>
                , <&macro_tap &kp X>
                , <&macro_release &kp LCTRL>
                , <&macro_release &kp LSHFT>
				;
        };

        wss: wss {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_press &kp LSHFT>
                , <&macro_tap &kp S>
                , <&macro_release &kp LGUI>
                , <&macro_release &kp LSHFT>
				;
        };
        csxcs: csxcs {
           compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_press &kp LSHFT>
                , <&macro_tap &kp X>
                , <&macro_release &kp LCTRL>
                , <&macro_release &kp LSHFT>
                , <&macro_press &kp LCTRL>
                , <&macro_tap &kp S>
                , <&macro_release &kp LCTRL>
                ;
        };

        csxcsaltf4: csxcsaltf4 {
           compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_press &kp LSHFT>
                , <&macro_tap &kp X>
                , <&macro_release &kp LCTRL>
                , <&macro_release &kp LSHFT>
                , <&macro_press &kp LCTRL>
                , <&macro_tap &kp S>
                , <&macro_release &kp LCTRL>
                , <&macro_press &kp LALT>
                , <&macro_tap &kp F4>
                , <&macro_release &kp LALT>
                ;
        };

    };

    behaviors {
        tdDEL: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp DEL>, <&kp LC(DEL)>;
        };

        tdBSPC: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp BSPC>, <&kp LC(BSPC)>;
        };

        tdPNT: tap_dance_2 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&csxcs>, <&csxcsaltf4>;
        };
    };

        keymap {
        compatible = "zmk,keymap";

        default_layer {
            //    ESC       1        2         3         4       5       6         7          8         9         0          -
            bindings = <
                &kp ESC    &kp N1  &kp N2    &kp N3    &kp N4   &kp N5  &kp N6  &kp N7     &kp N8     &kp N9    &kp N0    &mo 1
                &kp TAB    &kp Q   &kp W     &kp E     &kp R    &kp T   &kp Y   &kp U      &kp I      &kp O     &kp P     &kp BSPC
                &kp LCTRL  &kp A   &kp S     &kp D     &kp F    &kp G   &kp H   &kp J      &kp K      &kp L     &kp SEMI  &kp APOS
                &kp LSHFT  &kp Z   &kp X     &kp C     &kp V    &kp B   &kp N   &kp M      &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
                &mo 5      &mo 4   &kp LGUI  &kp LALT  &kp RET  &mo 6   &none   &kp SPACE  &kp UP     &kp DOWN  &kp LEFT  &kp RIGHT
            >;
        };

        BT_layer {
            display-name = "Layer 1 Bluetooth reset bootloader";
            //  ESC        1             2             3            4            5         6          7           8      9        0        -
            bindings = <
                &none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none       &none        &none  &none           &none  &none  &tog 4     &none
                &none  &none         &none         &none         &sys_reset  &none        &none  &studio_unlock  &none  &none  &kp PSCRN  &none
                &none  &none         &none         &none         &none       &tog 2       &none  &none           &none  &none  &none      &none
                &none  &none         &none         &bt BT_CLR    &none       &bootloader  &none  &tog 3          &none  &none  &none      &none
                &none  &none         &none         &none         &none       &none        &none  &none           &none  &none  &none      &none
            >;
        };

        gaming_layer {
            display-name = "Layer 2 Gaming";
            //    ESC         1          2          3          4          5          6          7          8          9          0          -
            bindings = <
                &kp ESC    &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_N0  &tog 2
                &kp TAB    &kp Q      &kp W      &kp E      &kp R      &kp T      &kp Y      &kp U      &kp I      &kp O      &kp P      &kp BSPC
                &kp LCTRL  &kp A      &kp S      &kp D      &kp F      &kp G      &kp H      &kp J      &kp K      &kp L      &kp SEMI   &kp APOS
                &kp LSHFT  &kp Z      &kp X      &kp C      &kp V      &kp B      &kp N      &kp M      &kp COMMA  &kp DOT    &kp UP     &kp RSHFT
                &mo 5      &none      &kp LGUI   &kp LALT   &kp SPACE  &mo 6      &none      &kp RET    &kp FSLH   &kp LEFT   &kp DOWN   &kp RIGHT
            >;
        };

            MACOS_layer {
            display-name = "layer 3 MACOS";
            //    ESC         1         2         3         4       5       6         7          8         9         0          -
            bindings = <
                &kp ESC    &kp N1     &kp N2    &kp N3    &kp N4   &kp N5  &kp N6  &kp N7     &kp N8     &kp N9    &kp N0    &tog 3
                &kp TAB    &kp Q      &kp W     &kp E     &kp R    &kp T   &kp Y   &kp U      &kp I      &kp O     &kp P     &kp BSPC
                &kp LCTRL  &kp A      &kp S     &kp D     &kp F    &kp G   &kp H   &kp J      &kp K      &kp L     &kp SEMI  &kp APOS
                &kp LSHFT  &kp Z      &kp X     &kp C     &kp V    &kp B   &kp N   &kp M      &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
                &mo 5      &kp LCTRL  &kp LALT  &kp LCMD  &kp RET  &mo 6   &none   &kp SPACE  &kp UP     &kp DOWN  &kp LEFT  &kp RIGHT
            >;
        };

            mouse_layer {
            display-name = "Layer 4 mouse";
            //    ESC       1      2       3           4              5           6          7               8                9            0          -
            bindings = <
                &kp ESC    &none  &none  &none     &none         &none           &none  &none           &none           &none            &none     &tog 4
                &kp TAB    &none  &kp W  &none     &none         &kp T           &none  &mkp MB1        &mmv MOVE_UP    &mkp MB2         &none     &none
                &kp LCTRL  &none  &none  &none     &none         &none           &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none     &none
                &kp LSHFT  &none  &none  &none     &msc SCRL_UP  &msc SCRL_DOWN  &none  &none           &none           &none            &none     &none
                &none      &none  &none  &kp LALT  &kp RET       &none           &none  &kp SPACE       &kp UP          &kp DOWN         &kp LEFT  &kp RIGHT
            >;
        };  

        Symbols_layer {
            display-name = "Layer 5 Symbols and macros";
            //    ESC         1             2              3           4       5       6         7          8          9         0         -
            bindings = <
                &kp F1     &kp F2      &kp F3         &kp F4         &kp F5   &kp F6  &kp F7  &kp F8     &kp F9     &kp F10    &kp F11   &kp F12
                &kp TILDE  &kp LA(F4)  &none          &kp LC(LS(X))  &tdPNT   &none   &none   &none      &none      &none      &none     &kp DEL
                &none      &none       &kp LG(LS(S))  &tdDEL         &tdBSPC  &none   &none   &kp PLUS   &kp MINUS  &kp EQUAL  &none     &none
                &none      &none       &none          &none          &none    &none   &none   &none      &kp LBKT   &kp RBKT   &none     &kp CAPS
                &none      &none       &none          &none          &none    &none   &none   &kp SPACE  &kp PG_UP  &kp PG_DN  &kp HOME  &kp END
            >;
        };

        Multimedia_layer {
            display-name = "Layer 6 Multimedia";
            //  ESC     1      2      3         4              5           6      7         8             9           0        -
            bindings = <
                &none  &none  &none  &none  &none         &none           &none  &none  &none         &none         &none     &none
                &none  &none  &none  &none  &none         &none           &none  &none  &none         &none         &kp C_PP  &none
                &none  &none  &none  &none  &none         &none           &none  &none  &none         &none         &none     &none
                &none  &none  &none  &none  &msc SCRL_UP  &msc SCRL_DOWN  &none  &none  &none         &none         &none     &none
                &none  &none  &none  &none  &none         &none           &none  &none  &kp C_VOL_UP  &kp C_VOL_DN  &none     &none
            >;
        };  
    };
};

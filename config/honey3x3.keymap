#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {

	macros {
        qbt: qbt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp SPACE>
                , <&macro_release &kp LCTRL>
				, <&macro_wait_time 500>
				, <&macro_tap &kp Q &kp B &kp RET>
                ;
        };
        tlgrm: telegram {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LGUI &kp T &kp E &kp L &kp E &kp RET>
                ;
        };
        obs: obs {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LGUI &kp O &kp B &kp S &kp RET>
                ;
        };
        stm: steam {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LGUI &kp S &kp T &kp E &kp A &kp RET>
                ;
        };
    };


    keymap {
        compatible = "zmk,keymap";
		
        default_layer {
            display-name = "Default Layer";

            bindings = <
               &kp ESC   &kp RET   &kp SPACE
               &mo 1     &kp UP    &mo 2
               &kp LEFT  &kp DOWN  &kp RIGHT
            >;

        };
        
        lower_layer {
            display-name = "Lower Layer (1)";
			
            bindings = <
               &to 3      &qbt       &kp F4
               &none      &kp TAB    &kp LALT
               &kp PG_DN  &kp LCTRL  &kp PG_UP
            >;
        };

        raise_layer {
            display-name = "BT and reset (2)";
			
            bindings = <
              &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2
              &bt BT_CLR      &none         &none
              &studio_unlock  &sys_reset    &bootloader
            >;
        };
        
        macro_layer {
            display-name = "Macro Layer (3)";
			
            bindings = <
              &tlgrm  &obs   &stm
              &none   &none  &none
              &none   &none  &none
            >;
        };
    };
};
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {

	macros {
        qbt: qbt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp SPACE>
                , <&macro_release &kp LCTRL>
                , <&macro_wait_time 500>
				, <&macro_tap_time 200>
				, <&macro_tap &kp Q &kp B &kp RET>
                ;
        };
    };


    keymap {
        compatible = "zmk,keymap";
		
        default_layer {
            display-name = "Default Layer";

            bindings = <
               &kp ESC  &kp RET  &kp SPACE
               &mo 1    &kp UP   &mo 2
               &kp LEFT &kp DOWN &kp RIGHT
            >;

        };
        
        lower_layer {
            display-name = "Lower Layer";
			
            bindings = <
               &mo 3    	&qbt			&kp F4
               &none    	&kp TAB     	&kp LALT
               &kp PG_DN   	&kp LCTRL   	&kp PG_UP
            >;
        };

        raise_layer {
            display-name = "Raise Layer";

            bindings = <
              &kp T         &kp C_PP       &kp C
              &kp F         &kp C_VOL_UP   &none
              &kp LT        &kp C_VOL_DN   &kp GT
            >;
			
            
        };

        extra_layer {
            display-name = "Extra Layer";
            
            bindings = <
              &none             &bt BT_SEL 1      &bt BT_SEL 2
              &none             &bt BT_CLR        &bt BT_SEL 0
              &studio_unlock    &sys_reset        &bootloader
            >;
        };

    };
};
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

&msc {
    x-input-code = <INPUT_REL_HWHEEL>;
    y-input-code = <INPUT_REL_WHEEL>;
    time-to-max-speed-ms = <10>;
    acceleration-exponent = <0>;
};

/ {
	macros {
        
        tlgrm: telegram {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LGUI &kp T &kp E &kp L &kp E &kp RET>
                ;
        };
        obs: obs {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LGUI &kp O &kp B &kp S &kp RET>
                ;
        };
        stm: steam {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LGUI &kp S &kp T &kp E &kp A &kp RET>
                ;
        };
        zoom: zoom {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LGUI &kp Z &kp O &kp O &kp M &kp RET>
                ;
        };
        pnt: paint {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LGUI &kp P &kp A &kp I &kp N &kp RET>
                ;
        };
        dscrd: discord {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LGUI &kp D &kp S &kp C &kp O &kp RET>
                ;
        };
        anki: anki {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LGUI &kp A &kp N &kp K &kp I &kp RET>
                ;
        };
        csc: csxcsaltf4 {
           compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_press &kp LSHFT>
                , <&macro_tap &kp X>
                , <&macro_release &kp LCTRL>
                , <&macro_release &kp LSHFT>
                , <&macro_press &kp LCTRL>
                , <&macro_tap &kp S>
                , <&macro_release &kp LCTRL>
                , <&macro_press &kp LALT>
                , <&macro_tap &kp F4>
                , <&macro_release &kp LALT>
                ;
        };
    };

    behaviors {
        mt1: mod_tap1 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&dscrd>, <&zoom>;
            display-name = "Mod-Tap1";
        };
    };


    keymap {
        compatible = "zmk,keymap";
		
        default_layer {
            display-name = "Default Layer (0)";

            bindings = <
               &kp ESC         &kp RET   &kp SPACE
               &mo 1           &kp UP    &mo 2
               &mt LEFT PG_UP  &kp DOWN  &mt RIGHT PG_DN
            >;

        };
        
        lower_layer {
            display-name = "Lower Layer (1)";
			
            bindings = <
               &tog 3     &tog 4     &kp F4
               &none      &kp TAB    &kp LALT
               &kp PG_DN  &kp LCTRL  &kp PG_UP
            >;
        };

        raise_layer {
            display-name = "BT and reset (2)";
			
            bindings = <
              &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2
              &bt BT_CLR      &none         &none
              &studio_unlock  &sys_reset    &bootloader
            >;
        };
        
        macro_layer {
            display-name = "Macro Layer (3)";
			
            bindings = <
              &obs   &stm    &mt1 0 0
              &none  &tog 4  &csc
              &zoom  &tlgrm  &anki
            >;
        };

        editing_layer {
            display-name = "Editing Layer (4)";
			
            bindings = <
              &kp DEL        &kp LC(DEL)  &kp LS(R)
              &kp LC(LS(G))  &tog 4       &kp LC(G)
              &msc SCRL_UP   &kp M        &msc SCRL_DOWN
            >;
        };

    };
};